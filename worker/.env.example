# --- LiveKit (Cloud oder self-hosted SFU) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
<REDACTED>
LIVEKIT_AGENT_NAME=edeka-agent

# --- LLM (OpenAI-kompatibel; Referenz: Melious + deepseek-v4.1-flash) ---
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.melious.ai/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
<REDACTED>
# --- STT (Referenz: Deepgram Nova-3, EU-Endpoint) ---
STT_PROVIDER=deepgram
STT_MODEL=nova-3
STT_LANGUAGE=de
STT_BASE_URL=https://api.eu.deepgram.com/v1/listen
STT_API_KEY=

# --- TTS (Referenz: Inworld inworld-tts-2) ---
TTS_PROVIDER=inworld
TTS_MODEL=inworld-tts-2
TTS_VOICE_ID=nadine-neu
TTS_BASE_URL=api.inworld.ai
TTS_API_KEY=

# --- Opener: deterministisch, wird als WAV abgespielt (kein TTS im Call) ---
OPENER_TEXT=Guten Tag! Hier ist Nadine vom Edeka Markt Bremerhaven. Was darf ich fuer Sie tun?
OPENER_WAV=/opt/node-cascade/opener.wav

# --- Backend (Produkt-/Bestell-API des Kunden) ---
BACKEND_URL=
TENANT_ID=
TRANSFER_NUMBER=
